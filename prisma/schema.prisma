// The Site Database's schema (Prisma ORM 7). Change it, then run
// `npx prisma migrate dev --name <what-changed>` against the Preview Database
// and wrap the new migration.sql in BEGIN; … COMMIT; (see AGENTS.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // The client runs in the Cloudflare Workers runtime, never in Node.
  runtime  = "workerd"
}

// The connection string is NOT here: prisma.config.ts reads DATABASE_URL from
// the environment, which the platform sets (the Build never gets one).
datasource db {
  provider = "postgresql"
}

/// The v0.1 starter's example table, no longer used by any screen. Kept because
/// dropping a table needs a migration and the owner's approval.
model Note {
  id        Int      @id @default(autoincrement())
  /// Shown as written. Never store a member's email address here.
  body      String   @db.VarChar(500)
  author    String?  @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("notes")
}

/// A job on the job board (`/jobs`, `/jobs/<slug>`). Site admins
/// (`community:site:update`) post and edit them from `/portal/jobs`.
model Job {
  id          Int      @id @default(autoincrement())
  /// URL name, unique: `/jobs/<slug>`.
  slug        String   @unique @db.VarChar(120)
  title       String   @db.VarChar(120)
  company     String   @db.VarChar(80)
  location    String   @db.VarChar(80)
  /// `full-time`, `part-time`, `contract` or `internship`.
  type        String   @default("full-time") @db.VarChar(20)
  remote      Boolean  @default(false)
  /// Plain text; paragraphs separated by blank lines.
  description String   @db.VarChar(10000)
  /// Where to apply: an https URL or a mailto: link the poster chose to publish.
  applyUrl    String   @map("apply_url") @db.VarChar(500)
  /// `open` (listed) or `closed` (kept, not listed).
  status      String   @default("open") @db.VarChar(10)
  /// The admin's community profile that posted it.
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, id])
  @@map("jobs")
}

/// A file a signed-in member uploaded from `/portal/uploads`. The bytes live
/// on the community's CDN (presign → PUT → register); this row keeps the
/// public URL the platform returned.
model Upload {
  id           Int      @id @default(autoincrement())
  /// The uploader's community profile (`/api/auth/me` → `profile.id`).
  profileId    Int      @map("profile_id")
  url          String   @db.VarChar(1000)
  originalName String   @map("original_name") @db.VarChar(100)
  fileType     String   @map("file_type") @db.VarChar(20)
  fileSize     Int      @map("file_size")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([profileId, id])
  @@map("uploads")
}

/// A message from the website's contact form (`/contact`): a general question
/// (`kind = contact`) or a request to book a demo (`kind = demo`). Sent by any
/// visitor, signed in or not; read by site admins (`community:site:update`) in
/// `/portal/inquiries`. The email is the address the sender typed so the team
/// can reply: it is never shown on a public page.
model Inquiry {
  id        Int      @id @default(autoincrement())
  /// `contact` or `demo`.
  kind      String   @default("contact") @db.VarChar(10)
  name      String   @db.VarChar(80)
  email     String   @db.VarChar(254)
  company   String?  @db.VarChar(120)
  /// `general`, `sales`, `support`, `partnership` (contact) or `demo`.
  topic     String   @default("general") @db.VarChar(20)
  /// Demo requests: rough community size, e.g. `1-100`.
  size      String?  @db.VarChar(20)
  message   String   @db.VarChar(5000)
  /// `new` or `handled`.
  status    String   @default("new") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, id])
  @@map("inquiries")
}
